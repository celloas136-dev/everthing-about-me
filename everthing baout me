<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cello's Personal Space ✈️</title>
    <!-- Font Google & Icon -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* === CSS VARIABLE & BASE STYLE === */
        :root {
            --bg-color: #f7f5f0;
            --card-bg: #ffffff;
            --text-color: #2b2d42;
            --accent-pink: #ffb3c6;
            --accent-pink-hover: #ff8fab;
            --accent-blue: #a2d2ff;
            --accent-blue-hover: #bde0fe;
            --shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
            --border-radius: 24px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 20px 15px;
            /* Pattern Polka-dot Tipis */
            background-image: radial-gradient(#e0e0e0 1.5px, transparent 1.5px);
            background-size: 24px 24px;
        }

        /* === 🎵 MUSIC PLAYER === */
        .music-player {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            width: 100%;
            max-width: 500px;
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            border: 2px solid #ffffff;
            text-align: center;
            margin-bottom: 20px;
        }

        .music-player h3 {
            font-family: 'Fredoka', cursive;
            font-size: 1.2rem;
            color: #d80032;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .song-select {
            width: 100%;
            padding: 12px 15px;
            border-radius: 12px;
            border: 2px solid var(--accent-blue);
            background: #fff;
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
            color: var(--text-color);
            outline: none;
            cursor: pointer;
            margin-bottom: 15px;
        }

        .controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-icon {
            background: var(--accent-pink);
            border: none;
            color: white;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-icon:hover {
            background: var(--accent-pink-hover);
            transform: scale(1.1);
        }

        .btn-mode {
            background: var(--accent-blue);
            border: none;
            color: #2b2d42;
            padding: 8px 16px;
            border-radius: 20px;
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-mode:hover {
            background: var(--accent-blue-hover);
        }

        /* === 📌 NAVIGATION === */
        .nav-menu {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            width: 100%;
            max-width: 500px;
        }

        .nav-btn {
            flex: 1;
            padding: 12px 15px;
            border: none;
            border-radius: 16px;
            background: var(--card-bg);
            color: var(--text-color);
            font-family: 'Fredoka', cursive;
            font-size: 0.95rem;
            cursor: pointer;
            box-shadow: var(--shadow);
            transition: all 0.3s ease;
        }

        .nav-btn.active {
            background: var(--accent-pink);
            color: white;
        }

        /* === KONTEN UTAMA === */
        .content-card {
            background: var(--card-bg);
            width: 100%;
            max-width: 500px;
            padding: 30px 25px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            display: none;
            animation: fadeIn 0.4s ease;
        }

        .content-card.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* === SLIDE SYSTEM === */
        .slide { display: none; text-align: center; }
        .slide.active { display: block; }

        .profile-img {
            width: 180px;
            height: 180px;
            object-fit: cover;
            border-radius: 50%;
            border: 6px solid var(--accent-blue);
            margin-bottom: 20px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }

        .profile-img:hover {
            transform: rotate(3deg) scale(1.02);
        }

        h2 {
            font-family: 'Fredoka', cursive;
            font-size: 1.5rem;
            color: #d80032;
            margin-bottom: 10px;
        }

        p {
            font-size: 0.95rem;
            line-height: 1.6;
            color: #555;
            margin-bottom: 15px;
        }

        /* Fact List */
        .fact-box {
            text-align: left;
            background: #fcf8f2;
            padding: 20px;
            border-radius: 16px;
            border-left: 5px solid var(--accent-pink);
            margin-bottom: 20px;
        }

        .fact-item {
            margin-bottom: 12px;
            font-size: 0.9rem;
        }

        .fact-item:last-child { margin-bottom: 0; }

        /* Form Styling */
        .form-group {
            text-align: left;
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .input-custom, .textarea-custom {
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            border: 2px solid #eee;
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s;
        }

        .input-custom:focus, .textarea-custom:focus {
            border-color: var(--accent-pink);
        }

        .textarea-custom {
            height: 100px;
            resize: none;
        }

        /* Buttons Action */
        .btn-action {
            width: 100%;
            padding: 12px 20px;
            border-radius: 14px;
            border: none;
            background: var(--accent-pink);
            color: white;
            font-family: 'Fredoka', cursive;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 8px;
        }

        .btn-action:hover { background: var(--accent-pink-hover); }

        .btn-secondary {
            background: #eee;
            color: #555;
        }

        .btn-secondary:hover { background: #e0e0e0; }

        .btn-group-flex {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .btn-group-flex button { flex: 1; }

        /* === 💭 MOOD EMOTICON & RECOMMENDATION === */
        .mood-container {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
        }

        .mood-btn {
            background: #fff;
            border: 2px solid #eee;
            font-size: 1.8rem;
            padding: 10px 15px;
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .mood-btn:hover, .mood-btn.selected {
            border-color: var(--accent-pink);
            background: #fff0f3;
            transform: translateY(-3px);
        }

        /* Pop-up Rekomendasi Lagu */
        .recom-box {
            display: none;
            background: #edf6f9;
            padding: 15px;
            border-radius: 16px;
            border: 2px dashed var(--accent-blue);
            margin-bottom: 20px;
            text-align: center;
        }

        .recom-box p {
            font-size: 0.85rem;
            margin-bottom: 10px;
            color: #2b2d42;
        }

        /* Mobile Responsive adjustment */
        @media (max-width: 480px) {
            body { padding: 12px 10px; }
            .content-card { padding: 20px 15px; }
            .btn-group-flex { flex-direction: column; }
            .profile-img { width: 150px; height: 150px; }
        }
    </style>
</head>
<body>

    <!-- 🎵 MUSIC PLAYER -->
    <div class="music-player">
        <h3><i class="fas fa-headphones"></i> Cello's Playlist</h3>
        <audio id="audioPlayer"></audio>
        
        <select id="songSelect" class="song-select" onchange="changeSong()">
            <option value="song1.mp3">1. The One That Got Away</option>
            <option value="song2.mp3">2. Secret Love Song</option>
            <option value="song3.mp3">3. Heather</option>
            <option value="song4.mp3">4. Somebody's Pleasure</option>
            <option value="song5.mp3">5. Cinnamon Girl - Lana Del Rey</option>
            <option value="song6.mp3">6. Into It - Chase Atlantic</option>
            <option value="song7.mp3">7. Multo</option>
            <option value="song8.mp3">8. Treat You Better</option>
            <option value="song9.mp3">9. Enchanted</option>
            <option value="song10.mp3">10. Angels Like You</option>
        </select>

        <div class="controls">
            <button class="btn-icon" onclick="prevSong()"><i class="fas fa-backward"></i></button>
            <button class="btn-icon" onclick="togglePlay()" id="playBtn"><i class="fas fa-play"></i></button>
            <button class="btn-icon" onclick="nextSong()"><i class="fas fa-forward"></i></button>
            <button class="btn-mode" onclick="toggleMode()" id="modeBtn">Mode: Urut ➡️</button>
        </div>
    </div>

    <!-- 📌 NAVIGATION MENU -->
    <div class="nav-menu">
        <button class="nav-btn active" id="btn-nav-about" onclick="switchSection('about')">🙋‍♂️ About Me</button>
        <button class="nav-btn" id="btn-nav-curhat" onclick="switchSection('curhat')">💭 Curhat & Cerita</button>
    </div>

    <!-- 🙋‍♂️ MENU 1: EVERYTHING ABOUT ME -->
    <div id="section-about" class="content-card active">
        
        <!-- SLIDE 1: PERKENALAN -->
        <div id="slide-1" class="slide active">
            <img src="foto-cello.jpg" alt="Foto Cello" class="profile-img">
            <h2>Hai, nama gua Cello Anung S ✨</h2>
            <p>Selamat datang di space pribadi gua! Lu bisa dengerin lagu sambil santai di sini.</p>
            <button class="btn-action" onclick="goToSlide(2)">Liat Fakta Gua ➡️</button>
        </div>

        <!-- SLIDE 2: FAKTA -->
        <div id="slide-2" class="slide">
            <h2>Fakta Random Gua 🚀</h2>
            <div class="fact-box">
                <div class="fact-item">🍲 <b>Makanan:</b> Bakso (Fix no debat, kuah angetnya selalu juara).</div>
                <div class="fact-item">🎣🏹 <b>Hobi:</b> Memancing (biar tenang) & Panahan (melatih fokus).</div>
                <div class="fact-item">✈️ <b>Cita-cita:</b> Bekerja di sektor Avionic (dunia penerbangan).</div>
                <div class="fact-item">🎂 <b>Lahir:</b> Ngawi, 05 Maret 2009.</div>
            </div>

            <div class="btn-group-flex">
                <button class="btn-action" onclick="goToSlide(3)">Mau kasih tau gua tentang lo ga?</button>
                <button class="btn-action btn-secondary" onclick="goToSlide(1)">⬅️ Balik</button>
            </div>
        </div>

        <!-- SLIDE 3: BIODATA VISITOR (OPSIONAL) -->
        <div id="slide-3" class="slide">
            <h2>Tentang Lo 🫵</h2>
            <p style="font-size: 0.85rem;">Isi aja kalo mau kenalan, skip juga santai kok gapapa!</p>
            
            <form onsubmit="submitVisitor(event)">
                <div class="form-group">
                    <label>Nama lo Siapa? (Opsional)</label>
                    <input type="text" class="input-custom" placeholder="Boleh nama panggilan aja...">
                </div>
                <div class="form-group">
                    <label>Instagram / Sosmed (Opsional)</label>
                    <input type="text" class="input-custom" placeholder="@username">
                </div>
                <button type="submit" class="btn-action">Kirim ✨</button>
            </form>

            <button class="btn-action btn-secondary" style="margin-top: 10px;" onclick="goToSlide(2)">⬅️ Balik ke Fakta</button>
        </div>

    </div>

    <!-- 💭 MENU 2: CURHAT & CERITA -->
    <div id="section-curhat" class="content-card">
        <h2>How is your day? ☁️</h2>
        <p>Pilih emotikon yang paling ngewakilin perasaan lo hari ini:</p>

        <!-- Pilihan Mood Emot -->
        <div class="mood-container">
            <button class="mood-btn" onclick="selectMood('seneng', 8, 'Enchanted')">😄</button>
            <button class="mood-btn" onclick="selectMood('sedih', 2, 'Heather')">😢</button>
            <button class="mood-btn" onclick="selectMood('kesel', 5, 'Into It')">😡</button>
            <button class="mood-btn" onclick="selectMood('chill', 4, 'Cinnamon Girl')">😌</button>
        </div>

        <!-- Pop-up Rekomendasi Lagu -->
        <div id="recomBox" class="recom-box">
            <p id="recomText">Rekomendasi lagu buat lo...</p>
            <div class="btn-group-flex">
                <button class="btn-action" style="font-size: 0.85rem;" onclick="applyRecommendedSong()">Putar Rekomendasi 🎵</button>
                <button class="btn-action btn-secondary" style="font-size: 0.85rem;" onclick="closeRecom()">Tetep Lagu Gua ✋</button>
            </div>
        </div>

        <!-- Form Curhat -->
        <form onsubmit="submitCurhat(event)">
            <div class="form-group">
                <label>Tumpahin aja apa yang lagi lo rasain di sini:</label>
                <textarea class="textarea-custom" placeholder="Hari ini ada kejadian seru, sedih, atau ada uneg-uneg? Ceritain aja..."></textarea>
            </div>
            <button type="submit" class="btn-action">Kirim Cerita 💌</button>
        </form>
    </div>

    <!-- 🛠️ JAVASCRIPT LOGIC -->
    <script>
        // === LOGIKA MUSIC PLAYER ===
        const audio = document.getElementById('audioPlayer');
        const songSelect = document.getElementById('songSelect');
        const playBtn = document.getElementById('playBtn');
        const modeBtn = document.getElementById('modeBtn');

        let isPlaying = false;
        let playMode = 0; // 0: Urut, 1: Acak, 2: Repeat 1 Lagu
        let tempRecommendedIndex = null;

        audio.src = songSelect.value;

        function togglePlay() {
            if (isPlaying) {
                audio.pause();
                playBtn.innerHTML = '<i class="fas fa-play"></i>';
            } else {
                audio.play();
                playBtn.innerHTML = '<i class="fas fa-pause"></i>';
            }
            isPlaying = !isPlaying;
        }

        function changeSong() {
            audio.src = songSelect.value;
            if (isPlaying) audio.play();
        }

        function nextSong() {
            let currentIndex = songSelect.selectedIndex;
            if (playMode === 1) { // Acak
                currentIndex = Math.floor(Math.random() * songSelect.options.length);
            } else if (playMode === 0) { // Urut
                currentIndex = (currentIndex + 1) % songSelect.options.length;
            }
            songSelect.selectedIndex = currentIndex;
            changeSong();
        }

        function prevSong() {
            let currentIndex = songSelect.selectedIndex;
            currentIndex = (currentIndex - 1 + songSelect.options.length) % songSelect.options.length;
            songSelect.selectedIndex = currentIndex;
            changeSong();
        }

        function toggleMode() {
            playMode = (playMode + 1) % 3;
            if (playMode === 0) modeBtn.innerHTML = "Mode: Urut ➡️";
            else if (playMode === 1) modeBtn.innerHTML = "Mode: Acak 🔀";
            else if (playMode === 2) modeBtn.innerHTML = "Mode: 1 Lagu 🔁";
        }

        audio.onended = function() {
            if (playMode === 2) {
                audio.play();
            } else {
                nextSong();
            }
        };

        // === LOGIKA SWITCH SECTION & SLIDE ===
        function switchSection(section) {
            document.getElementById('section-about').classList.remove('active');
            document.getElementById('section-curhat').classList.remove('active');
            document.getElementById('btn-nav-about').classList.remove('active');
            document.getElementById('btn-nav-curhat').classList.remove('active');

            if (section === 'about') {
                document.getElementById('section-about').classList.add('active');
                document.getElementById('btn-nav-about').classList.add('active');
            } else {
                document.getElementById('section-curhat').classList.add('active');
                document.getElementById('btn-nav-curhat').classList.add('active');
            }
        }

        function goToSlide(slideNum) {
            document.getElementById('slide-1').classList.remove('active');
            document.getElementById('slide-2').classList.remove('active');
            document.getElementById('slide-3').classList.remove('active');
            
            document.getElementById('slide-' + slideNum).classList.add('active');
        }

        // === LOGIKA MOOD & REKOMENDASI LAGU ===
        function selectMood(moodType, songIndex, songTitle) {
            const buttons = document.querySelectorAll('.mood-btn');
            buttons.forEach(btn => btn.classList.remove('selected'));
            event.currentTarget.classList.add('selected');

            tempRecommendedIndex = songIndex;
            const recomBox = document.getElementById('recomBox');
            const recomText = document.getElementById('recomText');

            recomText.innerHTML = `Lagi ngerasa <b>${moodType}</b> ya? Coba pasang lagu <b>"${songTitle}"</b> deh.`;
            recomBox.style.display = 'block';
        }

        function applyRecommendedSong() {
            if (tempRecommendedIndex !== null) {
                songSelect.selectedIndex = tempRecommendedIndex;
                changeSong();
                if (!isPlaying) togglePlay();
            }
            closeRecom();
        }

        function closeRecom() {
            document.getElementById('recomBox').style.display = 'none';
        }

        // === FORM SUBMIT HANDLERS ===
        function submitVisitor(e) {
            e.preventDefault();
            alert("Sip, makasih udah mau mampir dan kenalan! ✨");
            goToSlide(1);
        }

        function submitCurhat(e) {
            e.preventDefault();
            alert("Makasih udah cerita ke gua. Tetep semangat ya! 🚀");
            e.target.reset();
            closeRecom();
        }
    </script>
</body>
</html>
